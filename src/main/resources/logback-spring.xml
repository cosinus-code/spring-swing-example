<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="app.name" value="spring-swing-example"/>
    <property name="LOG_PATTERN" value="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %logger{1} - %msg%n"/>
    <property name="LOG_FILE"    value="${user.home}/.${app.name}/logs/application.log"/>
    <property name="LOG_FILE_PATTERN" value="${user.home}/.${app.name}/logs/%d{yyyy-MM}/application-%d{MM-dd-yyyy}.%i.log.gz"/>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_PATTERN}</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="org.cosinus" level="DEBUG" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="RollingFile"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="Console"/>
    </root>

</configuration>
